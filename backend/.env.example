# 이 파일을 .env로 복사해 값을 채운다. .env는 절대 커밋하지 않는다.
# 저장소가 공개 상태이므로 실제 키가 올라가면 즉시 노출된다.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/gojeom
DB_USERNAME=gojeom
DB_PASSWORD=gojeom

# --- JWT ---
# HS256용 시크릿. 최소 32바이트 이상 무작위 문자열을 쓴다.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes

# --- OpenAI ---
OPENAI_API_KEY=sk-...
# 모델 ID는 코드에 하드코딩하지 않고 여기서 핀 고정한다.
OPENAI_MODEL_TEXT=
OPENAI_MODEL_IMAGE=

# --- Object Storage (S3 호환) ---
# 얼굴 사진은 생체정보에 준하므로 국내 리전을 쓴다.
STORAGE_ENDPOINT=
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
