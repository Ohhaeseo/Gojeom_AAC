# 비워 두면 모든 화면이 프론트 mock 데이터로 동일하게 실행됩니다.
# 값을 넣으면 실제 백엔드에 붙습니다 (src/services/backend.ts).
# 비밀키는 EXPO_PUBLIC_ 변수나 프론트 저장소에 넣지 않습니다.
#
#   웹(expo start --web)  : http://localhost:8080/api/v1
#   실기기·시뮬레이터      : http://<PC의 LAN IP>:8080/api/v1
#                          (기기에서 localhost 는 기기 자신을 가리킨다)
#
# 백엔드 쪽도 함께 열어야 한다:
#   CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
#   (Expo 웹은 8081 을 쓴다. 실기기는 CORS 대상이 아니라 설정이 필요 없다)
EXPO_PUBLIC_API_BASE_URL=

# Google 로그인용 웹 클라이언트 ID.
# 백엔드 GOOGLE_CLIENT_ID 와 반드시 같은 값이어야 한다 — 백엔드가 이 값 하나만
# audience 로 허용하기 때문이다 (GoogleTokenVerifier). Android·iOS 클라이언트 ID 는
# 여기에도 백엔드에도 넣지 않는다. 네이티브 SDK 에 이 웹 ID 를 serverClientId 로
# 넘기면 발급되는 ID 토큰의 aud 가 이 값으로 유지된다.
# 클라이언트 ID 는 비밀이 아니다(브라우저에 그대로 노출된다). 클라이언트 시크릿은 쓰지 않는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
